# Ruta Viva - Backend environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` with real secrets.

# --- Auth / JWT ---
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
# Optional overrides (defaults in app/core/config.py)
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- LLM providers ---
OPENAI_API_KEY=your-openai-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# Optional override (default in app/core/config.py)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Weather ---
OPENWEATHER_API_KEY=your-openweather-api-key-here

# --- Database (optional overrides; defaults defined in app/core/config.py) ---
# POSTGRES_USER=admin
# POSTGRES_PASSWORD=admin
# POSTGRES_DB=rutaviva_db
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
